---
import Topics from "../data/topics.json";

import SubLayout from "../layouts/sub_layout.astro";
import SectionElement from "../components/SectionElement.astro";
import HorizontalSection from "../components/HorizontalSection.astro"
import HorSection2 from "../components/Hor-Section2.astro";
import Sidebar from '../components/Sidebar.astro';
import { Button } from 'free-astro-components';


import { Accordion, AccordionItem } from 'free-astro-components'

---

<SubLayout>
	<Sidebar currentPage="Games">
	</Sidebar>
    <HorizontalSection title="Arcade Games" direction="center" fontsize1="3rem" fontsize2="2rem" justifycontent="center" width="100%">
      <br>Learn while having fun.<br><br>
<section class="Games">

  <!-- GAME 1 -->
  <div class="GameCard">
      <iframe 
          src="https://view.genially.com/69b5552f8664db388c524ef7"
          title="Escape from Pixel Castle"
          frameborder="0"
      ></iframe>
      <div class="GameOverlay">
          <h3>Escape from Pixel Castle</h3>
          <a href="/Scaleculus/Game1/" target="_blank" class="PlayButton">Play Now</a>
      </div>
  </div>

  <!-- GAME 2 -->
  <div class="GameCard">
      <iframe 
          src="https://view.genially.com/69b5236e5405d724fc4b582d"
          title="Bomb Quiz"
          frameborder="0"
      ></iframe>
      <div class="GameOverlay">
          <h3>Bomb Quiz</h3>
          <a href="/Scaleculus/Game2/" target="_blank" class="PlayButton">Play Now</a>
      </div>
  </div>

  <!-- GAME 3 -->
  <div class="GameCard">
      <iframe 
          src="https://view.genially.com/69b575d77c50f40e0ddf341d"
          title="Dunk the Clown Quiz"
          frameborder="0"
      ></iframe>
      <div class="GameOverlay">
          <h3>Dunk the Clown Quiz</h3>
          <a href="/Scaleculus/Game3/" target="_blank" class="PlayButton">Play Now</a>
      </div>
  </div>

</section>
</HorizontalSection>

</SubLayout>

<style>
	html, body {
    overflow-x: hidden; 
}
    .Spacer { margin-top: 10rem; }
	:root {
    --wisteria: #BEADDCff;
    --shadow-grey: #141527ff;
    --petal-frost: #F7D3EBff;
    --thistle: #D7BCE4ff;
    --wisteria-2: #C493DAff;
    --amethyst-smoke: #C18EC7ff;
    --snow: #F8EEEDff;
    }

	.Section-con {
		display: flex;
		flex-wrap: wrap;
		align-items: center;

		gap: 2rem;
		justify-content: center; 
	}

	.Section-con2 {
    display: flex;               
    flex-wrap: wrap;            
    align-items: center;          
    justify-content: center;     
    gap: 1rem;

    width: 100%;
    min-height: 100vh;          

    background-color: rgba(20, 21, 39, 0.4);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);

    border: 2px solid var(--wisteria-2);
    border-radius: 1rem;
    box-shadow: 0 0 1rem rgba(193, 142, 199, 0.4);

	margin-bottom: 10rem;

    padding: 2rem;
    position: relative;
    z-index: 1;

    box-sizing: border-box;
	}

  .Games {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    justify-content: center;
}

.GameCard {
    position: relative;
    width: 30rem;
    height: 50rem;
    border-radius: 1rem;
    overflow: hidden;
    border: 2px solid var(--wisteria-2);

    /* Make iframe content scale */
    display: flex;
    justify-content: center;
    align-items: center;
    transition: 1s;
}

.GameCard iframe {
    width: 100%;
    height: 100%;
    border: none;

    /* Blur & disable interaction */
    filter: blur(6px) brightness(100%);
    pointer-events: none;

    /* Zoom content to fit while keeping aspect ratio */
    transform: scale(1.05); /* adjust as needed */
    transform-origin: top center;
     transition: 1s;
}

.GameCard:hover iframe{
filter: blur(6px) brightness(50%);
}

.GameOverlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    color: white;
    text-align: center;
}


.PlayButton {
    margin-top: 1rem;
    padding: 0.6rem 1.5rem;

    background: var(--wisteria-2);
    color: white;
    text-decoration: none;

    border-radius: 0.5rem;
    font-weight: bold;
    transition: 0.2s;
}

.PlayButton:hover {
    background: var(--amethyst-smoke);
}
</style>